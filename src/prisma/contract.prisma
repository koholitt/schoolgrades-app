// use prisma-8

enum Turn{
  morning
  afternoon
}

model Student{
  id Int @id @default(autoincrement())
  name String
  middleName String? @map("middle_name")
  lastName String @map("last_name")
  email String @unique
  status Boolean @default(true)

  @@map("students")
}

model Teacher{
  id Int @id @default(autoincrement())
  name String
  middleName String? @map("middle_name")
  lastName String @map("last_name")
  email String @unique
  status Boolean @default(true)

  @@map("teachers")
}

model Subject{
  id Int @id @default(autoincrement())
  name String
  credits Int
  semester Int
  status Boolean @default(true)

  @@map("subjects")
}

model Grade{
  id Int @id @default(autoincrement())
  studentId Int @map("student_id")
  student Student @relation(fields: [studentId], references: [id])
  teacherGroupSubjectId Int @map("teacher_group_subject_id")
  teacherGroupSubject TeacherGroupSubject @relation(fields: [teacherGroupSubjectId], references: [id])
  grade Float
  opportunity Int
  registerDate DateTime @default(now()) @map("register_date")

  @@unique ([studentId, teacherGroupSubjectId, opportunity]) //only triggers if three values are the same as other record
  @@map("grades")
}

model Group{
  id Int @id @default(autoincrement())
  semester Int
  turn Turn
  creationDate DateTime @default(now()) @map("creation_date")
  finishDate DateTime? @map("finish_date")
  status Boolean @default(true)

  @@map("groups")
}

model StudentGroup{
  id Int @id @default(autoincrement())
  studentId Int @map("student_id")
  student Student @relation(fields: [studentId], references: [id])
  groupId Int @map("group_id")
  group Group @relation(fields: [groupId], references: [id])

  @@unique([studentId, groupId])
  @@map("student_groups")
}

model TeacherGroupSubject{
  id Int @id @default(autoincrement())
  teacherId Int @map("teacher_id")
  teacher Teacher @relation(fields: [teacherId], references: [id])
  groupId Int @map("group_id")
  group Group @relation(fields: [groupId], references: [id])
  subjectId Int @map("subject_id")
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, groupId, subjectId])
  @@map("teacher_group_subjects")
}

//Add auth models after adding better auth

// Added by better-auth-adapter-prisma8 via `@better-auth/cli generate`.

model User {
  id            String    @id // id is generated by Better Auth, not the database
  name          String    // sortable
  email         String    @unique // sortable
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  // default is computed by Better Auth on write
  updatedAt     temporal.updatedAt() // default is computed by Better Auth on write, @updateAt is deprectaed 
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id // id is generated by Better Auth, not the database
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime // default is computed by Better Auth on write
  updatedAt temporal.updatedAt()
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id // id is generated by Better Auth, not the database
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  // default is computed by Better Auth on write
  updatedAt             temporal.updatedAt()
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id // id is generated by Better Auth, not the database
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime // default is computed by Better Auth on write
  updatedAt  temporal.updatedAt() // default is computed by Better Auth on write

  @@index([identifier])
  @@map("verification")
}

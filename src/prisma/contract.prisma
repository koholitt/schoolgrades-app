// use prisma-8

model students{
  id Int @id @default(autoincrement())
}

model teacher{
  id Int @id @default(autoincrement())
}

model subjects{
  id Int @id @default(autoincrement())
}

model grades{
  id Int @id @default(autoincrement())
}

model groups{
  id Int @id @default(autoincrement())
}


